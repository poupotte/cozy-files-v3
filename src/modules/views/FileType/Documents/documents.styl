// Documents page home, as the Mail.ru Documents: large create buttons, then
// filters over the recent documents (see ../Board/board.styl for the grid).

.documentsCreate
    display grid
    grid-template-columns repeat(auto-fill, minmax(12rem, 1fr))
    gap .75rem
    margin 0
    padding 0
    list-style none

.documentsCreate-button
    display flex
    align-items center
    gap .75rem
    width 100%
    padding .875rem 1rem
    border 1px solid var(--dividerColor)
    border-radius 12px
    background-color var(--paperBackgroundColor)
    color var(--primaryTextColor)
    font inherit
    text-align left
    cursor pointer
    transition border-color .15s, box-shadow .15s

    &:hover:not(:disabled),
    &:focus-visible
        border-color var(--primaryColor)
        box-shadow var(--shadow2)
        outline 0

    &:disabled
        cursor default
        opacity .6

// A create button and its templates arrow, side by side as one button
.documentsCreate-split
    display flex

    // The hovered half shows its whole border over the other
    > button:hover,
    > button:focus-visible
        position relative
        z-index 1

.documentsCreate-button--main
    border-top-right-radius 0 !important
    border-bottom-right-radius 0 !important
    min-width 0

.documentsCreate-toggle
    flex 0 0 auto
    justify-content center
    width 2.75rem !important
    padding 0 !important
    margin-left -1px
    border-top-left-radius 0 !important
    border-bottom-left-radius 0 !important
    color var(--secondaryTextColor) !important

    svg
        transition transform .15s

    &[aria-expanded='true']
        border-color var(--primaryColor)
        color var(--primaryColor) !important

        svg
            transform rotate(180deg)

.documentsCreate-icon
    flex-shrink 0
    width 2rem
    height 2rem

.documentsCreate-import
    display flex
    flex-shrink 0
    align-items center
    justify-content center
    width 2rem
    height 2rem
    border-radius 8px
    background-color var(--contrastBackgroundColor)
    color var(--secondaryTextColor)

.documentsCreate-label
    font-weight 500

.documentsCreate-input
    display none

.documentsFilters
    display flex
    flex-wrap wrap
    gap .5rem
    margin-bottom 1rem

.documentsFilters-chip
    padding .375rem .875rem
    border 1px solid var(--dividerColor)
    border-radius 2rem
    background-color transparent
    color var(--primaryTextColor)
    font inherit
    font-size .875rem
    cursor pointer
    transition background-color .15s, border-color .15s

    &:hover
        background-color var(--actionColorHover)

    &[aria-pressed='true']
        border-color var(--primaryColor)
        background-color var(--primaryColor)
        color var(--primaryContrastTextColor)

// The page of a PDF fills its tile from the top, as a document page.
.documentCard-pdf
    display block
    width 100%
    height 100%
    object-fit cover
    object-position top

// Templates of a kind of document, in a menu over the page: their tiles in
// rows rather than the strip of the Office pages.
.documentsTemplatesMenu
    box-sizing border-box
    width 44rem
    max-width calc(100vw - 2rem)
    max-height 70vh
    padding 0 1rem 1rem
    overflow-y auto

    h2
        margin-top 1rem

    ul
        display grid
        grid-template-columns repeat(auto-fill, minmax(9.5rem, 1fr))
        overflow visible
