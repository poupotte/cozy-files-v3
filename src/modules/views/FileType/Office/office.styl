// Office pages home, laid out as the Board home (see ../Board/board.styl):
// each tile shows the content of its file, shaped as a page, a sheet or a
// slide.

.officePreview
    position relative
    display block
    overflow hidden
    border 1px solid var(--dividerColor)
    border-radius 12px
    background-color var(--paperBackgroundColor)
    transition border-color .15s, box-shadow .15s

    &[data-status='loading']
        background-image linear-gradient(90deg, transparent, var(--contrastBackgroundColor), transparent)
        background-size 200% 100%
        animation officePreviewLoading 1.2s linear infinite

.officePreview--text
    aspect-ratio 4 / 5

.officePreview--sheet
    aspect-ratio 16 / 10

.officePreview--slide
    aspect-ratio 16 / 9

// Tiles of the files and of the templates
button:hover > .officePreview,
button:focus-visible > .officePreview
    border-color var(--primaryColor)
    box-shadow var(--shadow2)

.officePreview-icon
    position absolute
    inset 0
    display flex
    align-items center
    justify-content center
    background-color var(--contrastBackgroundColor)

// Document: the top of its first page
.officePreview-page
    position absolute
    inset 0
    padding 1rem 1.25rem
    overflow hidden
    font-size .5rem
    line-height 1.5
    color var(--secondaryTextColor)

    // The text fades out at the bottom of the tile, as a page goes on
    &::after
        content ''
        position absolute
        right 0
        bottom 0
        left 0
        height 3rem
        background linear-gradient(transparent, var(--paperBackgroundColor))

.officePreview-docTitle
    margin 0 0 .5rem
    overflow hidden
    font-size .75rem
    font-weight 600
    color var(--primaryTextColor)
    display -webkit-box
    -webkit-line-clamp 2
    -webkit-box-orient vertical

.officePreview-docLine
    margin 0 0 .375rem
    overflow hidden
    display -webkit-box
    -webkit-line-clamp 3
    -webkit-box-orient vertical

// Spreadsheet: its top left cells, with the column letters and row numbers
.officePreview-sheet
    width 100%
    height 100%
    border-collapse collapse
    table-layout fixed
    font-size .625rem
    color var(--primaryTextColor)

    th,
    td
        height calc(100% / 7)
        padding 0 .25rem
        overflow hidden
        border 1px solid var(--dividerColor)
        white-space nowrap
        text-overflow ellipsis

    th
        font-weight 500
        color var(--secondaryTextColor)
        background-color var(--contrastBackgroundColor)

    th:first-child
        width 1.5rem
        text-align center

    tr:first-child th,
    tr:first-child td
        border-top 0

    th:first-child,
    td:first-child
        border-left 0

// Presentation: its first slide
.officePreview-slideImage
    display block
    width 100%
    height 100%
    object-fit cover

.officePreview-slideTitle
    position absolute
    inset 0
    display flex
    align-items center
    justify-content center
    margin 0
    padding 1rem
    font-size .875rem
    font-weight 600
    text-align center
    color var(--primaryTextColor)

.officePreview-badge
    position absolute
    right .5rem
    bottom .5rem
    padding .125rem .5rem
    border-radius 1rem
    font-size .625rem
    color var(--primaryTextColor)
    background-color var(--paperBackgroundColor)
    box-shadow var(--shadow1)

// Blank file of the Create block
.officeBlank
    display flex
    align-items center
    justify-content center
    border 1px dashed var(--primaryColor)
    border-radius 12px
    background-color var(--primaryBackgroundLight, var(--contrastBackgroundColor))
    color var(--primaryColor)

button:hover .officeBlank,
button:focus-visible .officeBlank
    border-style solid
    box-shadow var(--shadow2)

@keyframes officePreviewLoading
    from
        background-position 100% 0
    to
        background-position -100% 0
